+    /// X-Apple-I-MD-LU, derived exactly as OmniSette's RemoteAnisetteV3 state does
+    /// (SideStore/apple-private-apis, omnisette/src/remote_anisette_v3.rs:
+    /// `AnisetteState::md_lu()` + `encode_hex`): the lowercase hex of SHA-256 over
+    /// the 16 raw keychain-identifier bytes — the same bytes whose UUID string
+    /// form is sent as X-Mme-Device-Id. Pure function of the persistent
+    /// identifier, so it is stable across requests for a given device identity.
+    private static func derivedLocalUserID(for identifier: UUID) -> String {
+        SHA256.hash(data: Data(identifier.uuidBytes))
+            .map { String(format: "%02x", $0) }
+            .joined()
+    }
